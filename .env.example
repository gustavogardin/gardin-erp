# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Necessária apenas para a aprovação pública de orçamento (sem login do cliente).
# Pegue em: Supabase > Project Settings > API Keys > aba "Legacy" > service_role
# ATENÇÃO: nunca exponha essa chave no navegador; ela só é usada em código de servidor.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
